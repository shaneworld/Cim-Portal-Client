{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIM Portal",
  "version": "0.1.0",
  "identifier": "com.cimportal.portal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "CIM 门户",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shaneworld/Cim-Portal-Client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMjE5NTk1Mzk3M0ZCMDEKUldRQiszTTVsWlVoclZ0SzJ5YnhkekFGR0dkQUQ4ckpNUjFLbzFZVTRKQ0kzbGpXb1R1OVc2VW8K"
    }
  }
}
